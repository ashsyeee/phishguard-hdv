# Local development: copy this file to `.env` and fill in your keys.
# Streamlit Community Cloud: put the same KEY=VALUE pairs in the app's
# "Secrets" box (TOML) instead - never commit `.env` or real keys.

GEMINI_API_KEY=
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=
URLHAUS_AUTH_KEY=

# WhoisXML API - free tier key from https://www.whoisxmlapi.com/
WHOISXML_API_KEY=
# urlscan.io - free key from https://urlscan.io/user/signup
URLSCAN_API_KEY=
